<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX"
        xmlns:res="using:ShareX.Localization"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d"
        d:DesignWidth="580"
        d:DesignHeight="520"
        x:Class="ShareX.SignInWindow"
        x:DataType="local:SignInViewModel"
        Title="{x:Static res:Strings.SignInWindow_Title}"
        Width="580"
        MinWidth="500"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- The secondary rank. Switching account and signing out are real actions and
             they stay reachable, but they are not what somebody who has just signed in
             came here to do, so they do not get to look like buttons. -->
        <Style Selector="HyperlinkButton.quiet">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid RowDefinitions="Auto,Auto">
            <Border Background="{DynamicResource ShareX.Brush.Background.Toolbar}" Padding="18,14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="6"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ShareX.Brush.Background.Panel}">
                        <TextBlock Classes="icon"
                                   Text="{Binding HeadingIcon}"
                                   FontSize="20"
                                   Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeadingText}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                        <TextBlock Classes="hint" Text="{Binding SubtitleText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,18" Spacing="10">
                <Border Classes="card" IsVisible="{Binding ShowServer}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.SignInWindow_Server}"/>
                        <TextBox x:Name="HostTextBox"
                                 MinHeight="32"
                                 Padding="8,5"
                                 IsEnabled="{Binding IsIdle}"
                                 PlaceholderText="https://files.example.com"
                                 Text="{Binding Host, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding HasStatus}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Panel Width="20" VerticalAlignment="Center">
                            <!-- A rotating glyph, not a ProgressBar. The bar was set to
                                 Width="18" to pass for a spinner, but the Fluent theme gives
                                 ProgressBar a MinWidth of 200 and MinWidth wins over Width during
                                 measure - so it stretched across the whole card and the status
                                 text sat on top of it. This also matches the two icons beside it,
                                 which is what the slot was built for. -->
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.loader_circle}"
                                       FontSize="18"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="50%,50%">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1"
                                                       IterationCount="INFINITE"
                                                       Easing="LinearEasing">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="RotateTransform.Angle" Value="0"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="RotateTransform.Angle" Value="360"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </TextBlock.Styles>
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.circle_check}"
                                       FontSize="18"
                                       IsVisible="{Binding HasSuccess}"
                                       Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.triangle_alert}"
                                       FontSize="18"
                                       IsVisible="{Binding HasError}"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                        </Panel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="card" IsVisible="{Binding HasAccount}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="21"
                                ClipToBounds="True"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ShareX.Brush.Control.Background}">
                            <Panel>
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.circle_user}"
                                           FontSize="22"
                                           IsVisible="{Binding Avatar.HasGlyph}"
                                           Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Avatar.Initials}"
                                           IsVisible="{Binding Avatar.HasInitials}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding Avatar.Image}"
                                       IsVisible="{Binding Avatar.HasImage}"
                                       Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding AccountName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="hint"
                                       Text="{Binding AccountDetails}"
                                       IsVisible="{Binding HasAccountDetails}"/>
                            <ProgressBar Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding QuotaPercent}"
                                         IsVisible="{Binding HasQuotaBar}"/>
                            <TextBlock Classes="hint"
                                       Text="{Binding QuotaText}"
                                       IsVisible="{Binding HasQuota}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <HyperlinkButton Classes="quiet"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding ShowManualToggle}"
                                 Content="{x:Static res:Strings.SignInWindow_ManualToggle}"
                                 Click="OnToggleManualClick"/>

                <Border Classes="card" IsVisible="{Binding ShowManualToken}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.SignInWindow_ManualHint}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="TokenTextBox"
                                     MinHeight="32"
                                     Padding="8,5"
                                     IsEnabled="{Binding IsIdle}"
                                     PlaceholderText="{x:Static res:Strings.SignInWindow_Token}"
                                     Text="{Binding ManualToken, Mode=TwoWay}"/>
                            <Button Grid.Column="1"
                                    Classes="compact"
                                    Content="{x:Static res:Strings.SignInWindow_UseToken}"
                                    IsEnabled="{Binding IsIdle}"
                                    Click="OnUseTokenClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Two ranks, and which button is the loud one depends on what the screen
                     is saying. Under a finished sign-in the loud one is Close, because the
                     thing the user came to do is done; "Switch account" as the primary
                     button offered to undo it, which is the opposite of a confirmation. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <HyperlinkButton Classes="quiet"
                                         Content="{x:Static res:Strings.SignInWindow_OtherServer}"
                                         IsVisible="{Binding ShowServerToggle}"
                                         Click="OnToggleServerClick"/>
                        <HyperlinkButton Classes="quiet"
                                         Content="{x:Static res:Strings.SignInWindow_SignInAgain}"
                                         IsVisible="{Binding IsConfirmed}"
                                         IsEnabled="{Binding IsIdle}"
                                         Click="OnSignInClick"/>
                        <HyperlinkButton Classes="quiet"
                                         Content="{x:Static res:Strings.SignInWindow_SignOut}"
                                         IsVisible="{Binding IsSignedIn}"
                                         IsEnabled="{Binding IsIdle}"
                                         Click="OnSignOutClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                        <Button Classes="compact"
                                Content="{x:Static res:Strings.SignInWindow_Cancel}"
                                IsVisible="{Binding IsBusy}"
                                Click="OnCancelClick"/>
                        <!-- Two Close buttons rather than one with a bound class: setting
                             Classes and Classes.primary on the same element leaves the
                             winner up to the order the two are applied in, and a primary
                             button that is sometimes not styled is worse than a duplicate
                             element. Exactly one of them is ever on screen. -->
                        <Button Classes="compact"
                                Content="{x:Static res:Strings.SignInWindow_Close}"
                                IsVisible="{Binding NeedsSignIn}"
                                IsCancel="True"
                                Click="OnCloseClick"/>
                        <Button Classes="compact primary"
                                Content="{x:Static res:Strings.SignInWindow_Close}"
                                IsVisible="{Binding IsConfirmed}"
                                IsCancel="True"
                                IsDefault="{Binding IsConfirmed}"
                                Click="OnCloseClick"/>
                        <Button Classes="compact primary"
                                Content="{x:Static res:Strings.SignInWindow_SignIn}"
                                IsVisible="{Binding NeedsSignIn}"
                                IsEnabled="{Binding IsIdle}"
                                IsDefault="{Binding NeedsSignIn}"
                                Click="OnSignInClick"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ThemeVariantScope>
</Window>
